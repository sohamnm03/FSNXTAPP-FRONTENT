{
  "name": "fsnxtapp-frontend",
  "version": "1.0.0",
  "description": "Windows desktop testing platform for FSNXT modules",
  "author": "FSNXT",
  "main": "electron/main.js",
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "start": "npm run dev",
    "electron": "npm run dev",
    "dev": "concurrently --kill-others --names renderer,desktop \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && node scripts/launchElectron.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run package:win",
    "package:win": "npm run build && electron-builder --win",
    "lint": "eslint .",
    "check:syntax": "node scripts/checkSyntax.js",
    "check": "npm run lint && npm run check:syntax && npm run build"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.fsnxt.testing",
    "productName": "FSNXT Testing Application",
    "asar": true,
    "asarUnpack": [
      "packages/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "packages/**/*",
      "!packages/**/.pytest_cache{,/**/*}",
      "!packages/**/__pycache__{,/**/*}",
      "!packages/**/*.pyc",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
