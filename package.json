{
  "name": "fsnxtapp-frontend",
  "version": "1.0.7",
  "description": "Windows desktop testing platform for FSNXT modules",
  "author": "FSNXT",
  "main": "electron/main.js",
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.241",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-oauth/google": "^0.13.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "start": "npm run dev",
    "electron": "npm run dev",
    "dev": "concurrently --kill-others --names renderer,desktop \"vite --host localhost\" \"wait-on http://localhost:5173 && node scripts/launchElectron.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run package:win",
    "package:win": "npm run build && node scripts/packageWindows.js",
    "lint": "eslint .",
    "test:desktop-auth": "node --test electron/googleDesktopAuth.test.js",
    "test:sap-payload": "node --test electron/sapAutomationPayload.test.js",
    "check:syntax": "node scripts/checkSyntax.js",
    "check": "npm run lint && npm run check:syntax && npm run build"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.fsnxt.testing",
    "productName": "FS Sprint",
    "asar": true,
    "asarUnpack": [
      "packages/**/*",
      "node_modules/@anthropic-ai/claude-code/bin/claude.exe"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.js",
      "scripts/sapAutomationPayload.js",
      "packages/**/*",
      "!packages/sap-testing-automation/**/*",
      "!packages/**/tools/mcp-abap-adt-api/node_modules{,/**/*}",
      "!packages/**/.claude/settings.local.json",
      "!packages/**/.mcp.json",
      "!packages/**/.env",
      "!packages/**/.venv{,/**/*}",
      "!packages/**/.pytest_cache{,/**/*}",
      "!packages/**/__pycache__{,/**/*}",
      "!packages/**/*.pyc",
      "!packages/**/cookies.txt",
      "!packages/**/headers.txt",
      "!packages/**/response_*.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".build/sap-web-runtime",
        "to": "sap-web-runtime"
      },
      {
        "from": ".build/sap-automation/sap-testing-automation.fsnxtpkg",
        "to": "sap-testing-automation.fsnxtpkg"
      },
      {
        "from": ".build/python-runtime/python",
        "to": "python"
      },
      {
        "from": ".build/node-runtime/node",
        "to": "node"
      },
      {
        "from": ".build/sap-development-mcp",
        "to": "sap-development-mcp"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
