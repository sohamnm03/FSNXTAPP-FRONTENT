@EndUserText.label : 'Treasury Budget'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #ALLOWED
define table /fs00/almtr010 {

  key mandt     : mandt not null;
  key zbukrs    : bukrs not null;
  key zyear     : /fs00/almdt0026 not null;
  key zdate     : /fs00/almdt0027 not null;
  key zgrp_id   : /fs00/almdt0001 not null;
  key zgrp_name : /fs00/almdt0003 not null;
  key zversion  : /fs00/almdt0028 not null;
  zv_date       : /fs00/almdt0029;
  @Semantics.amount.currencyCode : 'vtbfhapo.wzbetr'
  zamt          : /fs00/almdt0030;
  zcreated_by   : tb_cruser;
  zcreated_date : tb_dcrdat;
  zcreated_time : tb_tcrtim;
  zchanged_by   : tb_upuser;
  zchanged_date : tb_dupdat;
  zchanged_time : tb_tuptim;

}