# Local secrets - passwords and MCP bearer tokens live here.
# Never commit. config/sap-systems.json holds the non-secret metadata instead.
.claude/settings.local.json
.env
.env.local

# Generated from config/sap-systems.json by scripts/sync-sap-systems.ps1.
# Contains only ${VAR} references, but it is a build product - regenerate it.
.mcp.json

# Node tooling for the ABAP ADT API MCP server
tools/**/node_modules/
npm-debug.log*

# Python venv for the SAP GUI Scripting MCP server (recreate, don't commit).
tools/**/.venv/
__pycache__/

# Audit trail written by the sap-gui MCP server - may contain business data.
logs/

# Rendered dashboard output - regenerate with scripts/build-dashboard.ps1, references live worklog data.
dashboard/output/

# Evidence is NOT ignored. It lives beside the worklog that produced it, at
# worklog/<system-id>/<YYYY-MM>/evidence/<worklog-stem>/, and is committed -- the
# screenshots and transcripts are the proof a run happened and are worthless to a
# later session if they only exist on one machine. The old top-level evidence/
# root and its "evidence/**" ignore rule were retired on 2026-09-13 (L-502): the
# rule was unanchored, so it also shadowed the worklog evidence that 108 already
# committed files show was always meant to be tracked.

# Raw browser-MCP tool output (console/network dumps, page snapshots). Moved out of
# the repo root on 2026-09-14 (L-505) -- it is tool noise, not a build product and not
# evidence. Curated screenshots that prove a run happened belong in the worklog's
# evidence folder instead, and are committed. Covered by the logs/ rule above; named
# here so the reason survives.
logs/playwright-mcp/

# Graphify AST cache -- regenerate with `graphify update .` (AST-only, no API cost).
# The graph outputs themselves (GRAPH_REPORT.md, graph.json, graph.html, manifest.json)
# stay tracked: CLAUDE.md tells every agent to read them before answering architecture
# questions, so they must survive a fresh clone.
graphify-out/cache/

# Live-session artifacts from OData smoke tests. cookies.txt holds a real
# SAP_SESSIONID_<SID>_<client> and headers.txt a real x-csrf-token -- never commit either.
# Untracked on 2026-09-14 (L-506); git history was deliberately NOT rewritten, the
# captured DS4 dev session expired long ago.
cookies.txt
headers.txt
**/cookies.txt
**/headers.txt

# Python bytecode from the web console proxies (web/*/proxy.py).
*.pyc
