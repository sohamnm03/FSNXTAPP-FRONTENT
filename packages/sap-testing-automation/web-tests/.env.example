# Copy to web-tests/.env only if you run the web lane from a plain terminal.
#
# Inside Claude Code this is NOT needed: the password already comes from the
# "env" block of .claude/settings.local.json, which is the single place the
# secret lives for both test lanes.
#
# .env is gitignored. Never commit a real value.

SAP_DS4_100_NIIF_PASSWORD=

# Optional overrides:
# SAP_SYSTEM_ID=DS4_100_NIIF     # which system in config/sap-systems.json to drive
# SAP_BASE_URL=                  # override the registry's baseUrl (refuses production)
